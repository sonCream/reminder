# EC2 에 올릴 .env 의 견본. 이 파일을 서버에서 .env 로 복사해 값을 채운다.
# ⚠️ 이 파일과 .env 는 절대 커밋하지 않는다.

# ---- 도메인 ----
# Caddy 가 이 도메인으로 인증서를 발급받는다. 공개 DNS에서 조회돼야 한다.
APP_DOMAIN=reminder.회사도메인.com

# ---- 데이터베이스 (RDS) ----
# ⚠️ RDS 는 퍼블릭 접근을 끄고, 같은 VPC 의 EC2 보안그룹에서만 5432 를 허용한다.
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/reminder?sslmode=require

# ---- 웹 푸시 (VAPID) ----
# ⚠️ 개발용 키를 그대로 쓰지 말고 운영용으로 새로 발급한다.
#      npm run vapid
#    한 번 정하면 절대 바꾸지 않는다. 바꾸면 모든 기기의 구독이 무효가 된다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:운영자@회사도메인.com

# NEXT_PUBLIC_VAPID_PUBLIC_KEY 는 더 이상 필요 없다.
# NEXT_PUBLIC_* 는 빌드 시점에 코드로 박히는데 도커 빌드에는 .env 가 없어 undefined 가 된다.
# 지금은 브라우저가 /api/push/vapid-key 로 실행 시점에 받아간다.

# ---- 이메일 보조 알림 (선택) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- 로그인 (매직 링크) ----
# ⚠️ 인증을 붙이기 전에 쌓인 데이터는 'local' 계정에 묶여 있다.
#    아래 주소로 처음 로그인하는 사람이 그 데이터를 넘겨받는다.
#    설정하지 않으면 첫 로그인이 가져가므로, 운영에서는 반드시 지정한다.
AUTH_OWNER_EMAIL=

# 누가 로그인할 수 있는지. 아래 둘 중 하나라도 걸리면 통과한다.
# ⚠️ 둘 다 비워 두면 인터넷의 누구나 계정을 만들 수 있다. 최소 하나는 설정한다.
#
# 회사 도메인 단위로 열어둘 때 (사람이 늘어도 설정을 안 고쳐도 된다)
AUTH_ALLOWED_DOMAINS=creamhouse.net
# 도메인 밖의 특정 주소를 추가로 허용할 때 (쉼표로 여러 개)
AUTH_ALLOWED_EMAILS=

# ---- 워커 ----
NOTIFIER_CHANNELS=push
WORKER_CRON=* * * * *
