# 이 파일을 .env 로 복사해서 쓴다. .env 는 절대 커밋하지 않는다.
#   cp .env.example .env

# ---- 데이터베이스 ----
# 로컬 개발용. docker compose 가 이 값들로 Postgres 컨테이너를 띄운다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=reminder

# 호스트에서 prisma 명령을 쓸 때의 주소(컨테이너 안에서는 compose 가 db 로 덮어쓴다).
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/reminder

# 운영(EC2)에서는 위를 지우고 RDS 주소를 넣는다.
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/reminder?sslmode=require

# ---- 웹 푸시 (VAPID) ----
# 아래 명령으로 한 번만 만들고 계속 재사용한다. 키가 바뀌면 기존 구독이 전부 무효가 된다.
#   npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 브라우저 쪽에서도 공개키가 필요하다. VAPID_PUBLIC_KEY 와 같은 값을 넣는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- 이메일 보조 알림 (Gmail SMTP) ----
# Gmail 은 2단계 인증을 켠 뒤 '앱 비밀번호'를 발급받아야 한다. 계정 비밀번호로는 로그인되지 않는다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- 워커 ----
# 발송 채널: console | email | push  (쉼표로 여러 개)
# 개발 초기에는 console 만 켜두면 VAPID/SMTP 없이도 스케줄러를 검증할 수 있다.
NOTIFIER_CHANNELS=console
# 워커 실행 주기(cron). 기본 1분.
WORKER_CRON=* * * * *
